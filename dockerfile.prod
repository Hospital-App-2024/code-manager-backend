FROM node:22-alpine AS dependencies

RUN corepack enable
WORKDIR /usr/src/app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM dependencies AS build

COPY . .
RUN pnpm exec prisma generate
RUN pnpm run build

# Explicit release target invoked separately with runtime database secrets.
FROM build AS migrate
CMD ["pnpm", "run", "db:migrate:deploy"]

FROM build AS production-dependencies
RUN pnpm prune --prod

FROM node:22-alpine AS production

RUN apk add --no-cache tzdata
ENV TZ=America/Santiago
ENV NODE_ENV=production

WORKDIR /usr/src/app

COPY --from=production-dependencies /usr/src/app/node_modules ./node_modules
COPY --from=build /usr/src/app/dist ./dist
COPY --from=build /usr/src/app/prisma ./prisma
COPY --from=build /usr/src/app/fonts ./fonts

USER node
EXPOSE 3000

CMD ["node", "dist/main.js"]
