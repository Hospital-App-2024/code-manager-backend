PORT=3002
JWT_SECRET=some_secret
DATABASE_URL=postgres://postgres:password@localhost:5432/test
JWT_TOKEN_EXPIRATION=7d
JWT_REFRESH_SECRET=some_refresh_secret

# Explicit credentials used only by `pnpm db:seed`.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-secure-secret
ADMIN_SEED_NAME=Administrador Inicial

# Dedicated disposable database; required only by `pnpm test:migration`.
MIGRATION_TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/code_manager_migration_test

# DB DOCKER CONFIG
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=test
