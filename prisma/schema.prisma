generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(User)
  isActive  Boolean  @default(false)
}

enum Role {
  User
  Admin
  Operator
}

enum CodeType {
  GREEN
  BLUE
  AIR
  RED
  LEAK
}

enum BlueTeam {
  EMERGENCY
  ICU
  PEDIATRIC_ICU
}

model EmergencyCode {
  id             String   @id @default(uuid())
  type           CodeType
  activeBy       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  activationTime DateTime
  location       String
  operatorId     String
  operator       Operator @relation("RegisteredBy", fields: [operatorId], references: [id])
  observations   String?

  // Cierre: solo GREEN. Abierto = closedAt NULL; los demás tipos mantienen NULL.
  // closedByOperatorId es NULL en cierres históricos previos a este campo.
  closedBy           String?
  closedAt           DateTime?
  closedByOperatorId String?
  closedByOperator   Operator? @relation("ClosedBy", fields: [closedByOperatorId], references: [id], onDelete: Restrict)

  // Campos específicos Código Verde
  event  String?
  police Boolean?

  // Campos específicos Código Azul (uno o más equipos)
  teams BlueTeam[] @default([])

  // Campos específicos Código Aéreo
  emergencyDetail String?

  // Campos específicos Código Rojo
  cogridNotified        Boolean?
  cogridNotifiedAt      DateTime?
  firefighterCalledTime DateTime?

  // Campos específicos Código Fuga
  patientName        String?
  patientDescription String?

  // Índices de alto rendimiento
  @@index([type, activationTime(sort: Desc)])
  @@index([activationTime(sort: Desc)])
  @@index([operatorId])
  @@index([closedByOperatorId])
}

model Operator {
  id             String          @id @default(uuid())
  name           String
  emergencyCodes EmergencyCode[] @relation("RegisteredBy")
  closedCodes    EmergencyCode[] @relation("ClosedBy")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}
